{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "${3rd}/luv/library",
      "${3rd}/busted/library"
    ]
  },
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua"
    ]
  },
  "diagnostics": {
    "globals": ["vim"],
    "groupSeverity": {
      "ambiguity": "Warning",
      "await": "Warning",
      "codestyle": "Hint",
      "duplicate": "Warning",
      "global": "Warning",
      "lowercase-global": "Hint",
      "need-check-nil": "Warning",
      "redefined": "Warning",
      "strict": "Warning",
      "strong": "Warning",
      "type-check": "Warning",
      "unbalanced": "Warning",
      "unused": "Warning"
    }
  },
  "hint": {
    "enable": true,
    "paramName": true,
    "paramType": true,
    "setType": true
  }
}
